#include <iostream>
using namespace std;

int main() {

    string names[] = {"cheikh", "elmamoune", "nouzlat", "hadjira", "anass"};
    int ages[] = {20, 18, 25, 22, 30};

    int n = 5;
    string key;
    int low = 0;
    int high = n - 1;
    int mid;
    bool found = false;

    cout << "Enter name to search: ";
    cin >> key;

    // Binary Search
    while (low <= high) {

        mid = (low + high) / 2;

        if (names[mid] == key) {

            cout << key << " was found and is aged "
                 << ages[mid] << endl;

            found = true;
            break;
        }

        else if (names[mid] < key) {
            low = mid + 1;
        }

        else {
            high = mid - 1;
        }
    }

    if (found == false) {
        cout << "Not found" << endl;
    }

    return 0;
}
